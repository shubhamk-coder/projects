        <div class="title py-5">
            <h1>Node Image Uploader</h1>
            <p class="subtitle">Upload images to the <strong>Server</strong></p>
        </div>
        <div class="row justify-content-center">
            <div class="col-4">
                <form action="/uploadmultiple" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-8">
                        <input type="file" class="form-control" name="images" id="fromFile" multiple>
                    </div>
                    <div class="col-2">
